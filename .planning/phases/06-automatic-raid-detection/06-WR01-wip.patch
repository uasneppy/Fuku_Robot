+// slashFlood sends n texts that begin with text's command word, one per call in turn from
+// users, each carrying the bot_command entity Telegram puts on it.
+func slashFlood(env *lockdownEnv, users []gotgbot.User, n int, text string) {
+	env.t.Helper()
+	word := strings.Fields(text)[0]
+	for i := 0; i < n; i++ {
+		from := users[i%len(users)]
+		env.dispatchMessage(env.chat, gotgbot.Message{
+			From:     &from,
+			Text:     text,
+			Entities: []gotgbot.MessageEntity{{Type: "bot_command", Offset: 0, Length: int64(len(word))}},
+		})
+	}
+}
+
+// TestRaidFloodSlashText pins which slash-prefixed texts the flood counter exempts: only
+// the commands the bot handles, bare or addressed to this bot. Telegram marks any "/word"
+// as a command entity, so every other one is an item a raider could flood with.
+func TestRaidFloodSlashText(t *testing.T) {
+	t.Run("slash text no command takes locks the group", func(t *testing.T) {
+		env := newFloodEnv(t)
+		fresh := env.newMembers(4, 2*time.Hour)
+
+		slashFlood(env, fresh, 30, "/x spam")
+
+		row := env.activeLockdown()
+		if row == nil {
+			t.Fatal("no lockdown after 30 \"/x spam\" texts from recent joiners")
+		}
+		if row.TriggerKind != models.LockdownTriggerFlood {
+			t.Errorf("TriggerKind = %q, want flood", row.TriggerKind)
+		}
+	})
+
+	t.Run("a flood of a registered command does not count", func(t *testing.T) {
+		env := newFloodEnv(t)
+		fresh := env.newMembers(4, 2*time.Hour)
+
+		slashFlood(env, fresh, 40, "/lockdownstatus")
+		slashFlood(env, fresh, 40, "/lockdownstatus@"+env.bot.Username)
+
+		if items, newItems, accounts := floodSizes(t, env.chat.Id); items+newItems+accounts != 0 {
+			t.Errorf("commands counted %d items, %d new, %d accounts, want nothing", items, newItems, accounts)
+		}
+		if row := env.activeLockdown(); row != nil {
+			t.Errorf("a lockdown (kind %q) exists after a flood of the bot's own commands, want none", row.TriggerKind)
+		}
+	})
+
+	t.Run("a command addressed to another bot counts", func(t *testing.T) {
+		env := newFloodEnv(t)
+		fresh := env.newMembers(4, 2*time.Hour)
+
+		slashFlood(env, fresh, 30, "/lockdownstatus@otherbot spam")
+
+		if row := env.activeLockdown(); row == nil {
+			t.Fatal("no lockdown after 30 commands addressed to another bot from recent joiners")
+		}
+	})
+}
+
 func TestRaidFloodRule(t *testing.T) {
 	t.Run("56 percent does not lock", func(t *testing.T) {
 		env := newFloodEnv(t)
