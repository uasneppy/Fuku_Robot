index 0000000..43bf9dd
--- /dev/null
+++ b/alita/modules/raid_commands.go
@@ -0,0 +1,96 @@
+package modules
+
+import (
+	"reflect"
+	"sync"
+	"unsafe"
+
+	"github.com/PaulSonOfLars/gotgbot/v2"
+	"github.com/PaulSonOfLars/gotgbot/v2/ext"
+	"github.com/PaulSonOfLars/gotgbot/v2/ext/handlers"
+	log "github.com/sirupsen/logrus"
+)
+
+// The flood trigger does not count the bot's own commands (D-07), and it must not count
+// anything else that merely starts with a slash: Telegram marks any "/word" as a command
+// entity, so a raider who sends "/x buy crypto" from thirty fresh accounts would otherwise
+// never be counted. Which commands the bot handles is known only to the dispatcher, whose
+// handler table gotgbot keeps private and no module keeps a second copy of, so the table
+// is read from the dispatcher itself and each command handler is asked the question the
+// dispatcher asks it: does this message address you? That way a bare command, one addressed
+// to this bot (/cmd@botname), different letter case and the entity rules all behave exactly
+// as they do when the command is dispatched, and a command addressed to another bot, or one
+// the bot has no handler for, is ordinary content.
+
+var raidCommandsUnreadableOnce sync.Once
+
+// raidRegisteredCommands returns every command handler registered on d, in no particular
+// order. It reads gotgbot's private handler table through reflection, under the table's own
+// lock, and reports false when the table is not shaped as expected (a gotgbot upgrade that
+// renamed it); the flood watcher then counts every slash-prefixed text, and the tests of the
+// flood trigger fail on that.
+func raidRegisteredCommands(d *ext.Dispatcher) ([]handlers.Command, bool) {
+	if d == nil {
+		return nil, false
+	}
+	table := reflect.ValueOf(d).Elem().FieldByName("handlers")
+	if !table.IsValid() || table.Kind() != reflect.Struct {
+		return nil, false
+	}
+	mutexField := table.FieldByName("mutex")
+	mapField := table.FieldByName("handlers")
+	if !mutexField.IsValid() || !mapField.IsValid() || !mapField.CanAddr() || !mutexField.CanAddr() {
+		return nil, false
+	}
+	if mutexField.Type() != reflect.TypeOf(sync.RWMutex{}) {
+		return nil, false
+	}
+	// The pointers are made from the addresses of fields of a struct this package owns a
+	// pointer to, only to read what the dispatcher itself reads under the same lock.
+	mu := (*sync.RWMutex)(unsafe.Pointer(mutexField.UnsafeAddr()))                           //nolint:gosec // read-only view of gotgbot's handler table
+	readable := reflect.NewAt(mapField.Type(), unsafe.Pointer(mapField.UnsafeAddr())).Elem() //nolint:gosec // see above
+	groups, ok := readable.Interface().(map[int][]ext.Handler)
+	if !ok {
+		return nil, false
+	}
+
+	mu.RLock()
+	defer mu.RUnlock()
+	var commands []handlers.Command
+	for _, group := range groups {
+		for _, h := range group {
+			switch cmd := h.(type) {
+			case handlers.Command:
+				commands = append(commands, cmd)
+			case *handlers.Command:
+				if cmd != nil {
+					commands = append(commands, *cmd)
+				}
+			}
+		}
+	}
+	return commands, true
+}
+
+// raidCommandMatcher returns the question the flood counter asks of a text message: does a
+// command handler registered on d take it? When the dispatcher's table cannot be read it
+// answers no to everything and says so once, so a raid is never missed because the bot lost
+// track of its own commands.
+func raidCommandMatcher(d *ext.Dispatcher, b *gotgbot.Bot) func(msg *gotgbot.Message) bool {
+	return func(msg *gotgbot.Message) bool {
+		commands, ok := raidRegisteredCommands(d)
+		if !ok {
+			raidCommandsUnreadableOnce.Do(func() {
+				log.Warn("[RaidDetection] the dispatcher's command table could not be read, so no command is exempt from the flood count")
+			})
+			return false
+		}
+		ctx := ext.NewContext(b, &gotgbot.Update{Message: msg}, nil)
+		for _, cmd := range commands {
+			if cmd.CheckUpdate(b, ctx) {
+				return true
+			}
+		}
+		return false
+	}
+}
